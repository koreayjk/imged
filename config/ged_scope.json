    "statistics-probability": {
      "default_action": "exclude_unless_listed",
      "include": [
        { "match": "analyzing categorical data", "tier_min": "T2", "reason": "GED 자료해석 기초" },
        { "match": "displaying and comparing quantitative data", "tier_min": "T1", "reason": "공통 모듈 Unit 2: 도표·그래프 해석 (사회·과학 공용)" },
        { "match": "summarizing quantitative data", "tier_min": "T1", "reason": "공통 모듈 Unit 3: 평균·중앙값·산포 (사회·과학 공용)" },
        { "match": "modeling data distributions", "tier_min": "T2", "priority": "low", "reason": "백분위 등 GED 데이터 문항 (심화)" },
        { "match": "exploring bivariate", "tier_min": "T2", "reason": "공통 모듈 Unit 5: 산점도·상관 (사회·과학 공용)" },
        { "match": "study design", "tier_min": "T2", "reason": "GED Science 탐구설계 문항 대비" },
        { "match": "^probability$", "tier_min": "T2", "reason": "GED Math 확률 문항" },
        { "match": "counting, permutations", "tier_min": "T2", "priority": "low", "reason": "GED Math 경우의 수 (기초만)" }
      ],
      "exclude_reason_default": "추론통계(확률변수·표본분포·신뢰구간·유의성검정·카이제곱·회귀 심화·ANOVA)는 GED 범위 밖"

{
  "_comment": [
    "GED 출제 범위 필터. 유닛 제목 정규식(대소문자 무시)으로 매칭한다. 2026-08-28 TSV 익스포트의 실제 유닛 제목 기준.",
    "정책: default_action=include → exclude 목록에 걸리는 유닛만 제외.",
    "optional 목록은 포함하되 priority=low 로 표시. 기간 용량 초과 시 생성기가 low부터 자동 제외.",
    "global_exclude 는 모든 코스에 적용.",
    "근거: GED Mathematical Reasoning(대수 45%·양적추론 55%), GED Science(생명 40%·물상 40%·지구우주 20%),",
    "GED Social Studies(공민정부 50%·미국사 20%·경제 15%·지리 15%), GED RLA(지문분석·문법·작문)."
  ],
  "global_exclude": [
    { "match": "teacher resources", "reason": "교사용 자료 — 학생 커리큘럼 아님" },
    { "match": "through simulations", "reason": "시뮬레이션 체험 유닛 — 임베드 대상 영상 아님" },
    { "match": "standards mappings", "reason": "표준 매핑 문서 유닛 — 학습 콘텐츠 아님" }
  ],
  "courses": {
    "arithmetic": { "default_action": "include", "exclude": [], "optional": [] },

    "pre-algebra": {
      "default_action": "include",
      "exclude": [],
      "optional": [
        { "match": "^patterns$", "reason": "GED 직접 출제 영역 아님. 함수 개념 준비용" }
      ]
    },

    "basic-geometry": {
      "default_action": "include",
      "exclude": [
        { "match": "geometric transformations", "reason": "도형 변환은 GED Math 블루프린트에 없음" }
      ],
      "optional": [
        { "match": "intro to mass and volume|units of measurement|measuring angles", "reason": "기초 측정. 진단 통과자 다수 예상 — 마스터리 스킵 후보" }
      ]
    },

    "algebra-basics": {
      "default_action": "include",
      "exclude": [],
      "optional": [
        { "match": "^foundations$", "reason": "Pre-algebra와 중복 — 마스터리 스킵 후보" }
      ]
